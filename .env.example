# Copy to .env at the repo root for `docker compose up`.
# These values are substituted into docker-compose.yml. NEVER commit the real .env.

# LLM provider: groq | openai | google | mock
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=

# Auth / admin (generate strong random values for prod)
JWT_SECRET=
ADMIN_KEY=

# Comma-separated allowed frontend origins (browser CORS)
CORS_ORIGINS=http://localhost:3000
